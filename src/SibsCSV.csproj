<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <ModuleVersion>1.0.0</ModuleVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Output folder for the module -->
    <ModuleOutputDir>$(MSBuildProjectDirectory)\..\distrib\Module\$(AssemblyName)</ModuleOutputDir>
  </PropertyGroup>

  <!-- Don't copy SDK PowerShell to output folder -->
  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.*">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Copy the module manifest to output folder -->
  <ItemGroup>
    <None Update="Module\SibsCSV.psd1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SibsCSV.psd1</Link>
    </None>
  </ItemGroup>

  <!-- Automatic copy the module to output folder -->
  <Target Name="PackageModule" AfterTargets="Build">
    <ItemGroup>
      <ModuleFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(ModuleOutputDir)" />
    <Copy SourceFiles="@(ModuleFiles)" DestinationFolder="$(ModuleOutputDir)\$(ModuleVersion)\%(RecursiveDir)" />
    <Message Text="The module folder: $(ModuleOutputDir)" Importance="high" />
  </Target>

<ItemGroup>
  <!-- Apply to all .resx files (excluding files like Resources.ru.resx) -->
  <EmbeddedResource Update="**\*.resx" Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '\.[a-zA-Z]{2}(-[a-zA-Z0-9]+)?$'))">
    <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
    <StronglyTypedNamespace>SIBS.PowerShell.CSV</StronglyTypedNamespace>
    <StronglyTypedClassName>%(Filename)</StronglyTypedClassName>
    <StronglyTypedFileName>$(MSBuildProjectDirectory)\gen\%(Filename).Designer.cs</StronglyTypedFileName>
  </EmbeddedResource>
</ItemGroup>

<!-- Remove duplicate files before compile. -->
<Target Name="RemoveDuplicateGeneratedResources" BeforeTargets="CoreCompile">
  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\gen\*.Designer.cs" />
  </ItemGroup>
</Target>
</Project>
